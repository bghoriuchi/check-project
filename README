# サーバ起動
python3 -m uvicorn check01:app --reload

# 動作確認
## (1)参照
curl -X GET http://localhost:8000/books
## (2)追加
curl -X POST http://localhost:8000/books -H "Content-Type: application/json" -d '{"title":"タイトル１", "author":"一郎", "pages":10, "published":true}'
curl -X POST http://localhost:8000/books -H "Content-Type: application/json" -d '{"title":"タイトル２", "author":"二郎", "pages":20, "published":true}'
## (3)削除
curl -X DELETE http://localhost:8000/books/0
